# Configuration des clés d'API et notifications pour VolAlerte
# Copiez ce fichier sous le nom .env et renseignez vos clés si vous souhaitez quitter le mode Démo.

# Mode Démo (1 = données fictives riches pour tester sans aucune clé, 0 = mode réel)
DEMO_MODE=1

# Clé API Travelpayouts (Gratuite sur https://www.travelpayouts.com)
TRAVELPAYOUTS_TOKEN=

# Clé API SerpApi pour Google Flights (100 requêtes/mois gratuites sur https://serpapi.com)
SERPAPI_API_KEY=

# Canaux d'alerte activés (séparés par une virgule: windows,telegram,ntfy)
ALERT_CHANNELS=windows,ntfy

# Configuration Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configuration ntfy (optionnel - gratuit sans inscription sur https://ntfy.sh)
# Choisissez un nom de sujet unique, ex: volalerte_bpaquereau_99
NTFY_TOPIC=volalerte_alertes

# Port du serveur local FastAPI
APP_PORT=8765
APP_HOST=127.0.0.1

# Heure de la vérification quotidienne (format HH:MM)
DAILY_CHECK_TIME=09:00
